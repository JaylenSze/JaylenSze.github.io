---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout>
  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <div class="hero__content">
      <p class="hero__eyebrow">CS and Math · University of Toronto</p>
      <h1 class="hero__name">Jaylen Sze</h1>
      <p class="hero__role">Aspiring Researcher</p>
    </div>
    <a href="#leadership" class="hero__scroll-hint">↓ scroll</a>
    <p class="hero__contact">jaylensze at gmail dot com</p>
  </section>


  <!-- ========== LEADERSHIP ========== -->
  <section class="section section--alt" id="leadership">
    <div class="container">
      <h2 class="section__title reveal">Timeline</h2>
      <div class="vtl" id="vtl">
        <div class="vtl__line" aria-hidden="true"><div class="vtl__fill" id="vtlFill"></div></div>
        <div class="vtl__era reveal"><span>Current</span></div>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot vtl__dot--now"></span>
          <div class="vtl__card">
            <p class="vtl__date">Oct. 2026 - Present <span class="vtl__now">Now</span></p>
            <h3 class="vtl__title">Trustworthy Machine Intelligence Club Project Team Member</h3>
            <p class="vtl__org">University of Toronto</p>
            <ul class="vtl__list">
              <li>Working on the <strong>Socrative Tutor AI</strong> project · <a href="https://github.com/jakemaly/tutor" target="_blank" rel="noopener">GitHub</a></li>
            </ul>
          </div>
        </article>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot vtl__dot--now"></span>
          <div class="vtl__card">
            <p class="vtl__date">Oct. 2026 - Present <span class="vtl__now">Now</span></p>
            <h3 class="vtl__title">Undergraduate Student Research Program Mentee</h3>
            <p class="vtl__org">Computer Science Student Union, University of Toronto</p>
            <ul class="vtl__list">
              <li>Mentee under <a href="https://www.cs.toronto.edu/~ziyang/" target="_blank" rel="noopener">Ziyang Yang</a> · <a href="https://github.com/ziyang-theory/USRP-UofT" target="_blank" rel="noopener">GitHub</a></li>
            </ul>
          </div>
        </article>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot vtl__dot--now"></span>
          <div class="vtl__card">
            <p class="vtl__date">Sep. 2026 - Present <span class="vtl__now">Now</span></p>
            <h3 class="vtl__title">Web Dev Club Project Team Member</h3>
            <p class="vtl__org">University of Toronto</p>
            <ul class="vtl__list">
              <li>Working on the <strong>Autism Home Base</strong> project · <a href="https://github.com/uoftweb/autism-home-base" target="_blank" rel="noopener">GitHub</a></li>
            </ul>
          </div>
        </article>
        <div class="vtl__era reveal"><span>University</span></div>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Jun. 2026 - Aug. 2026</p>
            <h3 class="vtl__title">CSC396 Human-Centered Design Project Team Member</h3>
            <p class="vtl__org">University of Toronto Summer Abroad, Berlin, Germany</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Researched compulsive social media scrolling through <strong>39 questionnaires, 9 interviews</strong> and an observational study of <strong>7 participants</strong></li><li>Paper-prototyped and usability-tested an individual design, then combined team prototypes into a <strong>high-fidelity prototype</strong></li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Mar. 2026</p>
            <h3 class="vtl__title">Wikipedia Racing <span class="vtl__tag">Project</span> <a class="vtl__gh" href="https://github.com/JaylenSze/CSC111Project2" target="_blank" rel="noopener">GitHub</a></h3>
            <p class="vtl__org">Course Project · Python, Graph Theory, NetworkX</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Finds the fastest path between two Wikipedia pages using <strong>Breadth-First Search</strong> over <strong>1M+ page links</strong></li><li>Visualizes shortest paths with <strong>NetworkX</strong></li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Jan. 2026 - Apr. 2026</p>
            <h3 class="vtl__title">STA130 Data Analysis Project with Clean Air Task Force</h3>
            <p class="vtl__org">University of Toronto</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Cleaned raw electricity indicator data in <strong>R</strong> and grouped <strong>44+ countries</strong> into three regions</li><li>Built boxplots and summary tables showing regional electrification gaps for CATF's electricity scorecard</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <div class="vtl__era reveal"><span>High School</span></div>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Sep. 2023 - Jun. 2025</p>
            <h3 class="vtl__title">Math Club Founder &amp; Head</h3>
            <p class="vtl__org">A. Y. Jackson S. S.</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Founded the club and grew participation <strong>2&times;</strong> via tiered lessons, announcement videos, and social media</li><li>Introduced <strong>2 new math competitions</strong> to the school</li><li>Taught <strong>27 lessons</strong> and over <strong>100 problems</strong> to club members</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Sep. 2020 - Jun. 2025</p>
            <h3 class="vtl__title">High Performance Team Member</h3>
            <p class="vtl__org">RA Badminton Club, Ottawa, ON</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Trained <strong>4 times a week</strong> for 5 years; won the <strong>Ottawa junior championships</strong> and a <strong>provincial circuit tournament</strong></li><li>Represented the club at national-level tournaments and coached at summer camps</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Sep. 2021 - May 2025</p>
            <h3 class="vtl__title">Varsity Ultimate Frisbee Team Captain</h3>
            <p class="vtl__org">A. Y. Jackson S. S.</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Led the team to a <strong>6th-place</strong> finish out of <strong>41 teams</strong> and two <strong>2nd-place</strong> finishes</li><li>Studied professional footage to design targeted drills and improve team weaknesses</li><li>Organized unofficial practices and captain's meetings to raise team-wide skill and buy-in</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Apr. 2025</p>
            <h3 class="vtl__title">Mic Drop Madness <span class="vtl__tag">Project</span> <a class="vtl__gh" href="https://github.com/JaylenSze/MicDropMadness" target="_blank" rel="noopener">GitHub</a></h3>
            <p class="vtl__org">Lockdown 2025 High School Hackathon · 2nd place of 23 teams</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Real-time karaoke battle game in <strong>PyGame</strong> that scores live audio 0–10</li><li>Feeds results to the <strong>Gemini API</strong> for personalized singing feedback</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--left reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Mar. 2025</p>
            <h3 class="vtl__title">FacePalm <span class="vtl__tag">Project</span> <a class="vtl__gh" href="https://github.com/MichaelZjQu/FacePalm" target="_blank" rel="noopener">GitHub</a></h3>
            <p class="vtl__org">Scrapyard 2025 High School Hackathon · 2nd place of 29 teams</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Full-stack <strong>Flask</strong> web app that reads facial expressions with <strong>DeepFace</strong></li><li>Passes emotion data to the <strong>Gemini API</strong> for real-time tailored responses</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
        <article class="vtl__item vtl__item--right reveal">
          <span class="vtl__dot"></span>
          <div class="vtl__card">
            <p class="vtl__date">Summer 2024</p>
            <h3 class="vtl__title">SHAD Design Entrepreneurship Project Team Member</h3>
            <p class="vtl__org">SHAD, University of New Brunswick</p>
            <div class="vtl__extra"><div>
              <ul class="vtl__list"><li>Interviewed companies and consumers to identify gaps in existing carbon-emission solutions for small businesses</li><li>Built a <strong>3D prototype</strong> and delivered a <strong>5-minute pitch</strong> to judges after a month-long project with a team of 4</li></ul>
            </div></div>
            <button type="button" class="vtl__more" aria-expanded="false">Show more</button>
          </div>
        </article>
      </div>
    </div>
  </section>


  <!-- ========== AWARDS ========== -->
  <section class="section" id="awards">
    <div class="container">
      <h2 class="section__title reveal">Awards &amp; Achievements</h2>
      <ul class="award-list">
        <li class="award-list__item reveal">
          <span class="award-list__date">October 2026</span>
          <div class="award-list__body">
            <h3 class="award-list__title">2026 Innis Later Life Scholarship</h3>
            <p class="award-list__desc">Scholarship given to Innis College student for <strong>outstanding academic performance</strong>.</p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">May 2026</span>
          <div class="award-list__body">
            <h3 class="award-list__title">University of Toronto Dean's List Scholar</h3>
            <p class="award-list__desc">Awarded for GPA above 3.5 for the 2025-2026 Academic Year.</p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">December 2025</span>
          <div class="award-list__body">
            <h3 class="award-list__title">2026 MAA Putnam Competition</h3>
            <p class="award-list__desc">Placed <strong>1,822 out of 4,335</strong> as a freshman, the largest math competition for undergrad students.</p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">June 2025</span>
          <div class="award-list__body">
            <h3 class="award-list__title">Governor General's Academic Medal</h3>
            <p class="award-list__desc">Awarded for the <strong>highest academic average</strong> out of 200+ students in the 2025 graduating class.</p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">April 2025</span>
          <div class="award-list__body">
            <h3 class="award-list__title">Euclid Math Competition School Champion</h3>
            <p class="award-list__desc">Placed <strong>1,524 out of 27,092</strong> (<strong>top 6%</strong>), Canada's largest math competition for high school students.</p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">February 2024</span>
          <div class="award-list__body">
            <h3 class="award-list__title">Canadian Computing Competition Senior Division Honour Roll</h3>
            <p class="award-list__desc">Placed <strong>187 out of 3,947</strong> (<strong>top 5%</strong>), Canada's largest coding competition for high school students. <a class="award-list__link" href="/files/ccc-honour-roll.pdf" target="_blank" rel="noopener">View official results (PDF)</a></p>
          </div>
        </li>
        <li class="award-list__item reveal">
          <span class="award-list__date">February 2023</span>
          <div class="award-list__body">
            <h3 class="award-list__title">Cayley Math Competition</h3>
            <p class="award-list__desc">Placed <strong>73rd in Canada</strong> in the Cayley Contest. <a class="award-list__link" href="/files/cayley-results.pdf" target="_blank" rel="noopener">View official results (PDF)</a></p>
          </div>
        </li>
      </ul>
    </div>
  </section>




</BaseLayout>
